[gd_resource type="StandardMaterial3D" format=3]

; The metal frame of a gem button. This is the value that matters most and the one the glb got
; wrong: the export carried `metallicFactor = 0.465, roughnessFactor = 0.5`, which renders as
; grey plastic. Polished steel is a full metal at low roughness — it has almost no diffuse
; response and shows the environment instead, which is why the scene needs a sky to reflect
; before any of this can look right. Base tone is a cool silver (a faint blue cast), matching
; the reference's chrome.
[resource]
albedo_color = Color(0.78, 0.8, 0.84, 1)
metallic = 1.0
metallic_specular = 0.5
roughness = 0.12
