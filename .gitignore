# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Ignore the large asset folder (replace with your actual path)
/assets/cards/

# System-specific ignores
.DS_Store
thumbs.db
*.tmp

# Screenshot harness output (from tools/shot.gd). Regenerable diagnostics, kept out so a run's PNGs cannot
# quietly pile up in history. The TOOLS are committed; only their output is ignored.
tools/shots/
# Editor backups, logs and layered art sources (export the PNG; the source stays local)
*.blend1
*.log
*.psd
