extends Node3D
## THE PHASE DIAL around a big priority button (it replaced the phase prism): seven phase marks carved into the wood
## on one arc centred on the button (shaders/phase_dial.gdshader), and a small brass triangle on the button's housing
## that turns around the button to point at the current phase's mark, which glows.
##
## A child of each forward DiscSocket (ButtonStations builds it), so it follows that station's position and its
## half turn on the far seat. Local frame = the socket's: origin on the button's axis at the socket origin (world y
## 0.085). From the board camera, screen-up is local +Z and screen-left is local +X (for the near seat).
##
## Marks, left to right on screen: Active/Draw (dot), Main 1 (card), Attack (sword), Block (shield), Damage (burst),
## Main 2 (card), End (dot).

const SHADER := preload("res://shaders/phase_dial.gdshader")
const MARKS := 7
const ARC_RADIUS := 0.53
const ICON_SCALE := 1.6
## Screen angles (degrees, counter-clockwise from screen-right) of the first and last mark: an arc over the button
## (centred on 70 degrees) that keeps clear of the Cancel button, which sits up and to the left. 13.5 degrees apart.
const FIRST_ANGLE := 110.5
const LAST_ANGLE := 29.5
## The marks lie just above the ground round the station, relative to the socket origin (world y 0.185). The stations
## stand on the raised LEDGE generated by Blender/build_board.py (LEDGE 0.165 + noise): under the dial the baked
## board is 0.158-0.171, so the marks sit at 0.172. At 0.155 (the older ledge) the whole dial was buried under the
## board and simply vanished; phase_dial_probe now measures the real board mesh under it. Re-check after a re-bake.
const WOOD_Y := 0.172 - 0.185
## The pointer lies ON THE WOOD with its base against the stone housing's outer wall, and slides along that wall as
## it turns. The housing (Blender/build_button_housing.py) is a 12-sided drum: corner radius 0.401 (BIG_R 0.30 +
## GAP 0.016 + RIM 0.085), corners at Blender angle 12 + 30k degrees, so its flat faces sit at the apothem.
const HOUSING_CORNER_RADIUS := 0.401
const HOUSING_FIRST_CORNER_DEG := 12.0
const POINTER_Y := WOOD_Y + 0.0005
const POINTER_LENGTH := 0.06
const POINTER_HALF_WIDTH := 0.026
const POINTER_THICKNESS := 0.009
const TURN_SECONDS := 0.55
const GLOW_SECONDS := 0.35

var _material: ShaderMaterial
var _pointer_pivot: Node3D
var _pointer_mesh: MeshInstance3D
var _turn_tween: Tween
var _glow_tween: Tween
var _slot := -1


func _ready() -> void:
	_build_marks()
	_build_pointer()
	_set_pointer_angle(slot_angle(0))
	_material.set_shader_parameter("active_slot", 0.0)


## Which mark a phase or step lights. Active and Draw share the first; Preparation and Declaration share the sword;
## the combat end step stays on the burst until Main 2.
static func slot_for(phase: int) -> int:
	match phase:
		GlobalVariables.Phase.ACTIVE_PHASE, GlobalVariables.Phase.DRAW_PHASE:
			return 0
		GlobalVariables.Phase.FIRST_MAIN_PHASE:
			return 1
		GlobalVariables.Phase.ATTACK_PREPARATION_STEP, GlobalVariables.Phase.ATTACK_DECLARATION_STEP:
			return 2
		GlobalVariables.Phase.BLOCKER_DECLARATION_STEP:
			return 3
		GlobalVariables.Phase.DAMAGE_RESOLUTION_STEP, GlobalVariables.Phase.COMBAT_END_STEP:
			return 4
		GlobalVariables.Phase.SECOND_MAIN_PHASE:
			return 5
	return 6


## Screen angle (radians, counter-clockwise from screen-right) of a mark.
static func slot_angle(slot: int) -> float:
	return deg_to_rad(lerpf(FIRST_ANGLE, LAST_ANGLE, float(slot) / float(MARKS - 1)))


## A mark's centre in this dial's local frame (on the wood).
static func mark_position(slot: int) -> Vector3:
	var a := slot_angle(slot)
	return Vector3(-cos(a) * ARC_RADIUS, WOOD_Y, sin(a) * ARC_RADIUS)


func current_slot() -> int:
	return _slot


## Distance from the button's axis to the housing's outer wall at a screen angle (radians).
static func wall_radius(a: float) -> float:
	# Screen angle a -> Blender angle a + 180 degrees (Godot local (x, z) = (-cos a, sin a) = Blender (x, -y)).
	var blender_deg := rad_to_deg(a) + 180.0
	var face_offset := fposmod(blender_deg - (HOUSING_FIRST_CORNER_DEG + 15.0) + 15.0, 30.0) - 15.0
	var apothem := HOUSING_CORNER_RADIUS * cos(deg_to_rad(15.0))
	return apothem / cos(deg_to_rad(face_offset))


## The pointer's tip and the middle of its base, local frame.
func pointer_tip() -> Vector3:
	return _pointer_pivot.transform * (_pointer_mesh.position + Vector3(POINTER_LENGTH, 0.0, 0.0))


func pointer_base() -> Vector3:
	return _pointer_pivot.transform * _pointer_mesh.position


func show_phase(phase: int) -> void:
	var slot := slot_for(phase)
	if slot == _slot:
		return
	var first := _slot < 0
	_slot = slot
	if _turn_tween != null and _turn_tween.is_valid():
		_turn_tween.kill()
	if _glow_tween != null and _glow_tween.is_valid():
		_glow_tween.kill()
	var goal := slot_angle(slot)
	if first or not is_inside_tree():
		_set_pointer_angle(goal)
		_material.set_shader_parameter("active_slot", float(slot))
		_material.set_shader_parameter("active_glow", 1.0)
		return
	_turn_tween = create_tween()
	_turn_tween.tween_method(_set_pointer_angle, _pointer_angle(), goal, TURN_SECONDS) \
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	# The old mark dims, the new one lights as the pointer arrives.
	_glow_tween = create_tween()
	_glow_tween.tween_method(_set_glow, 1.0, 0.0, GLOW_SECONDS * 0.5)
	_glow_tween.tween_callback(func() -> void: _material.set_shader_parameter("active_slot", float(slot)))
	_glow_tween.tween_method(_set_glow, 0.0, 1.0, GLOW_SECONDS)


func _set_glow(value: float) -> void:
	_material.set_shader_parameter("active_glow", value)


## The pointer is built pointing along local +X; turning the pivot by PI + a points it at screen angle `a`
## (local direction (-cos a, sin a)).
func _set_pointer_angle(a: float) -> void:
	_pointer_pivot.rotation.y = PI + a
	# Slide out or in so the base stays against the housing wall (faces and corners are at different radii).
	_pointer_mesh.position = Vector3(wall_radius(a), POINTER_Y, 0.0)


func _pointer_angle() -> float:
	return _pointer_pivot.rotation.y - PI


func _build_marks() -> void:
	_material = ShaderMaterial.new()
	_material.shader = SHADER
	_material.set_shader_parameter("arc_radius", ARC_RADIUS)
	_material.set_shader_parameter("first_angle", FIRST_ANGLE)
	_material.set_shader_parameter("last_angle", LAST_ANGLE)
	_material.set_shader_parameter("icon_scale", ICON_SCALE)
	# The board is drawn in the transparent pass; without a higher priority it is sorted over the marks.
	_material.render_priority = 2
	var plane := PlaneMesh.new()
	var extent := (ARC_RADIUS + 0.08) * 2.0
	plane.size = Vector2(extent, extent)
	var marks := MeshInstance3D.new()
	marks.name = "PhaseMarks"
	marks.mesh = plane
	marks.material_override = _material
	marks.position.y = WOOD_Y
	marks.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(marks)


func _build_pointer() -> void:
	_pointer_pivot = Node3D.new()
	_pointer_pivot.name = "PointerPivot"
	add_child(_pointer_pivot)
	var mesh := MeshInstance3D.new()
	_pointer_mesh = mesh
	mesh.name = "Pointer"
	mesh.mesh = _triangle_prism()
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.vertex_color_use_as_albedo = true
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	mesh.material_override = material
	mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_pointer_pivot.add_child(mesh)


## A flat brass triangle lying on the wood: base at the mesh origin (placed against the housing wall), tip pointing
## out along +X. Shaded by vertex colour (top lit, sides darker) so it reads under the unshaded look of the coin.
func _triangle_prism() -> ArrayMesh:
	var tip := Vector2(POINTER_LENGTH, 0.0)
	var left := Vector2(0.0, -POINTER_HALF_WIDTH)
	var right := Vector2(0.0, POINTER_HALF_WIDTH)
	var y0 := 0.0
	var y1 := POINTER_THICKNESS
	var top_colour := Color(0.86, 0.66, 0.34)
	var side_colour := Color(0.48, 0.33, 0.15)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Top face (seen from above: counter-clockwise from outside is clockwise for Godot's front faces).
	for v in [tip, right, left]:
		st.set_color(top_colour)
		st.add_vertex(Vector3(v.x, y1, v.y))
	# The three side walls.
	var outline: Array[Vector2] = [tip, left, right]
	for i in 3:
		var a: Vector2 = outline[i]
		var b: Vector2 = outline[(i + 1) % 3]
		var quad: Array[Vector3] = [Vector3(a.x, y1, a.y), Vector3(a.x, y0, a.y), Vector3(b.x, y0, b.y),
			Vector3(a.x, y1, a.y), Vector3(b.x, y0, b.y), Vector3(b.x, y1, b.y)]
		for q in quad:
			st.set_color(side_colour)
			st.add_vertex(q)
	return st.commit()
