[gd_scene load_steps=8 format=3]

; Viewing scene for the gem button. Press F6 with this open and you see the REAL GemButton — text
; viewport, hover scale, gem glow and all — under a copy of the game's studio sky, with no match and
; no menu in the way.
;
; tests/button_probe.tscn asserts that this scene's sky matches game.tscn's, so the two cannot
; drift apart and quietly make the preview stop representing the game.

[ext_resource type="PackedScene" path="res://GemButton.tscn" id="1_button"]

[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_preview"]
